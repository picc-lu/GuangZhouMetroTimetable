    {
      "version": "1.2.11a",
      "date": "2026-11-06",
      "items": [
        { "type": "新增", "text": "线网拓扑图全面支持夜间模式，并支持主题实时切换重绘" },
        { "type": "修复", "text": "修复“保守优先”排序算法在特定单一组合下未生效（永远返回1）的死逻辑问题" },
        { "type": "修复", "text": "修复多个弹窗嵌套打开时（如路径规划叠加线路详情），页面滚动锁定错乱的问题" },
        { "type": "修复", "text": "修复 11 号线数据增量补抓时，内外环全程车状态可能错乱的问题" },
        { "type": "修复", "text": "修复到达模式下获取当前站方向文案时，缺少基于实际出发时间的兜底问题" },
        { "type": "优化", "text": "引入统一脚本加载机制（bootstrap.js），降低模块间加载顺序依赖，提升异常排查与容错能力" },
        { "type": "优化", "text": "抽离全局站名规范化模块（station-name.js），彻底解决“机场北、礌岗、清布”等特殊站点在不同功能中匹配不一致的问题" },
        { "type": "优化", "text": "清理冗余无用的票价缓存代码，精简代码体积" }
      ]
    },
    {
